# Copy this file to .env and fill in what you use. Everything is optional:
# with nothing set, the app runs on a local SQLite file in data/.

# Supabase database (Project Settings -> Database -> Connection string -> URI, "Session pooler")
DATABASE_URL=

# Supabase storage for uploaded documents (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=clinic-documents

# Address people open the app on (used in emailed links)
APP_URL=http://localhost:8050

# Email for invites and password resets (any SMTP provider, e.g. Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional AI
GEMINI_API_KEY=
